  },
  "peerDependencies": {
    "vite": "^5.1.8 || ^6 || ^7 || ^8"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
