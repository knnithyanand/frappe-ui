{
  "name": "frappe-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for frappe-ui packages",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --if-present --filter './packages/*' run typecheck",
    "test": "pnpm -r --if-present --filter './packages/*' run test",
    "lint": "pnpm -r --if-present run lint",
    "docs:dev": "vitepress dev docs --host",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "node docs/scripts/propsgen.ts --trace-uncaught",
    "dev:playground": "pnpm --dir examples/playground run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "vitepress": "^2.0.0-alpha.15",
    "storybook": "^10.3.5",
    "@storybook/vue3-vite": "^10.3.5",
    "@chromatic-com/storybook": "^5.1.1",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "vitest": "^4.1.3",
    "playwright": "^1.59.1",
    "@vitest/browser-playwright": "^4.1.3",
    "@vitest/coverage-v8": "^4.1.3"
  }
}
